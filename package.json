{
  "name": "tecnia-bot",
  "version": "0.4.2",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "description": "Tecnia Bot — asistente educativo de IA para enseñar Arduino y ESP32 en escuelas técnicas argentinas (INET). Capa educativa sobre OpenCode.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "fichas:manifest": "node scripts/fichas-manifest.mjs",
    "fichas:check": "node scripts/fichas-manifest.mjs --check",
    "seguridad:check": "node scripts/seguridad-proyectos.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.4.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/programadores-obreros/Agente-editor-inet.git"
  }
}
