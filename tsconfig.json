{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["opencode/tool/**/*.ts", "opencode/plugins/**/*.ts", "opencode/plugins/**/*.tsx", "opencode/nucleo/**/*.ts", "opencode/vista-fisica/**/*.ts", "opencode/servidor/**/*.ts"]
}
